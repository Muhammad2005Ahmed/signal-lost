# ---------- Server ----------
PORT=5000
NODE_ENV=development
# The website's address. Only this origin may call the API from a browser (CORS).
# Local: http://localhost:5173   Deployed: https://your-site.com   (comma-separate several if needed)
CLIENT_URL=http://localhost:5173
RATE_LIMIT_PER_MIN=60

# ---------- A.R.I.A (Google Gemini) ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
RAG_TOP_K=4
# Best chunk must score at least this (cosine, 0-1) or A.R.I.A answers "no data" without calling the LLM.
# Tune it with: npm run test:rag (the test prints every score)
RAG_MIN_SCORE=0.35
CHAT_RATE_PER_MIN=20

# ---------- Contact form / Beacon (Gmail + Nodemailer) ----------
# EMAIL_USER : the Gmail address that SENDS the mail
# EMAIL_PASS : a 16-character Gmail App Password (NOT your normal Gmail password). Steps are in README.md
# EMAIL_TO   : where the messages arrive (can be the same address)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=abcdefghijklmnop
EMAIL_TO=your_email@gmail.com
# Optional: seconds a visitor must spend on the form before it can be sent (bot check). Default 3.
CONTACT_MIN_SECONDS=3
# Optional: sends allowed per IP per 10 minutes. Default 3.
CONTACT_RATE_LIMIT=3
